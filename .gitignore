
# Fed Board release XML. H41 is over GitHub's 100MB limit; the two H.8
# copies are the 75MB files named in the 24 Sep 2026 migration. Not stored
# here. data/a1_money_creation/FRB_h41.zip and FRB_h8.zip are the Board
# packages under 50MB; unzipping them restores these XML files.
data/a1_money_creation/H41_data.xml
data/a1_money_creation/H8_data.xml
data/a1_money_creation/h8_data/H8_data.xml

# Python bytecode caches (were committed by mistake before 24 Sep 2026)
__pycache__/

# Third-party inputs the scripts read but this repository does not redistribute
# (README, "Checking the work"). Download them locally; never commit them.
data/vintages/shiller_*/
data/vintages/damodaran_*/
bin/*.xls
bin/DGS10.csv
bin/DFII10.csv
data/eps_split/panel/yahoo_splits.csv

# R1 rates inputs (Treasury CSVs, NY Fed ACM workbook, Fed Board Kim-Wright CSV): fetched by the script, not redistributed
data/vintages/r1_treasury/
data/vintages/r2_treasury/

# N2c refresh input: three tables from the Fed Board Z.1 release of 11 Sep 2026, fetched by bin/build_closure_2026Q2.py
data/vintages/z1_20260911/

# R3 inputs (MoF, JSDA, BoJ, ECB and Bundesbank files): fetched by bin/r3_jgb_egb.py, not redistributed
data/vintages/r3/

# ALFRED (FRED) vintages: third-party data kept in the private companion (E-011); copy locally to rebuild z_k (_research/n2b_v2/build_zk.py)
data/vintages/alfred/

# FINRA margin workbooks: bin/pull_series.py saves a dated copy each run; third-party, kept private (E-011)
data/vintages/finra/

# Gold ledger and COT price inputs from sponsors (SPDR, iShares, LBMA, WGC, LME mirrors): third-party, kept local (E-011)
data/vintages/gold/
data/vintages/cot_prices/

# Crude ledger: World Bank Pink Sheet cross-check (local only)
data/vintages/crude/

# N-PORT Treasury-duration build: outputs of a run with a hard check FAIL are written here and the committed files are left alone
data/nport/_FAILED/

# Fund futures and index split build: outputs of a run with a hard check FAIL are written here and the committed files are left alone
data/nport/_FAILED_fut_idx/

# Swap-tape ledger (E-024): the DTCC PPD zips are never committed (the cache is ~/dtcc_ppd/, outside the repo; the script refuses a cache inside it);
# Treasury CMT CSVs are fetched by bin/swap_tape_ledger.py, not redistributed
CFTC_CUMULATIVE_RATES_*
data/vintages/swap_tape_ust/

# ICE Brent COT ledger (E-025): the ICE COTHist files are never committed (the cache is ~/ice_cot/, outside the repo; the script refuses a cache inside it)
COTHist*.csv

# FX rate-gap build (E-021 queue item 4): raw downloads (Treasury, MoF, ECB, BIS, Bundesbank) and the weekly panel, which would let a reader rebuild
# yield levels, stay in this cache and are never committed (spec R4, O-6). A STOP file here is the fetch latch; only a person deletes it.
data/vintages/fx_rate_gap/
# A build with a hard check FAIL writes its outputs here and leaves the committed files alone
data/fx_rate_gap/_FAILED/
# R15 yield-comovement build (spec 8.9): the raw files live in ~/r15_yield_cache/, outside the repository (the script refuses a cache inside it);
# these patterns are a second line of defence. Only derived statistics are committed, under data/r15_yield_comovement/.
glc*.zip
GLC*.zip
latest-yield-curve-data.zip
jgbcme*.csv
*BBSIS*
data/r15_yield_comovement/weekly_panel*
# Gold vs real yield (E-021 item 5): the World Bank Pink Sheet workbook is never committed (the cache is ~/gold_ry_cache/, outside the repository; the script refuses a cache inside it)
CMO-Historical-Data-Monthly*.xlsx
# COT horizons (bin/cot_horizons.py): the two EIA NYMEX futures workbooks and the local weekly futures panel are never committed (G24)
data/vintages/cot_horizons/
# JODI world oil ledger (spec 2026-10-18): JODI's terms say "All such rights are reserved", so no JODI annual CSV is ever committed. The cache is
# ~/jodi_oil/, outside the repository (bin/build_jodi_oil_ledger.py refuses a cache inside it); bin/check.sh M12 looks for the rest.
jodi_primary_*.csv
primaryyear*.csv
secondaryyear*.csv
# FX-hedged Treasury yield build (bin/hedged_ust_yield.py): raw downloads (Treasury, MoF, ECB, NY Fed, BoJ, Bundesbank, the DKS panel extract), the daily
# panel and the yen monthly rows stay in this cache and are never committed. A STOP file here is the fetch latch; only a person deletes it.
data/vintages/hedged_ust_yield/
# A build with a hard check FAIL or a failed gate writes its outputs here and leaves the committed files alone
data/hedged_ust_yield/_FAILED/
# Japanese life insurers' foreign long-term debt build (bin/jp_life_foreign_bonds.py): the raw MoF files (every vintage) and the Bank of Japan statement PDFs stay in this
# cache and are never committed. The latch files STOP (a MoF failure) and STOP_BOJ (a BoJ failure) live here; only a person deletes them.
data/vintages/jp_life_foreign_bonds/
# A build with a hard check FAIL writes its outputs here and leaves the committed files alone
data/jp_life_foreign_bonds/_FAILED/

# UK gold exports to China and Hong Kong (bin/uk_gold_exports.py): raw HMRC and Comtrade replies, the Swiss monthly cache and the STOP latches stay here and are
# never committed. A STOP_hmrc or STOP_comtrade file here is the fetch latch; only a person deletes it.
data/vintages/uk_gold_exports/
# A build with a hard check FAIL writes its outputs here and leaves the committed files alone
data/uk_gold_exports/_FAILED/

# Fed H.8 net due to related foreign offices (bin/h8_foreign_offices.py): the release XML zip, the DDP packages, the notes pages, the 20-series subsets of every vintage and
# the STOP latches stay here and are never committed (the Board's files are public domain; they are kept out for size). A STOP_xml, STOP_ddp or STOP_notes file here is the
# fetch latch; only a person deletes it.
data/vintages/h8_foreign_offices/
# A build with a hard check FAIL writes its outputs here and leaves the committed files alone
data/h8_foreign_offices/_FAILED/
# BIS international debt securities in US dollars (bin/bis_ids_dollar.py): the raw SDMX replies of every pull and the STOP latch stay in this cache and are never
# committed. A STOP file here is the fetch latch; only a person deletes it.
data/vintages/bis_ids_dollar/
# A build with a hard check FAIL writes its outputs here and leaves the committed files alone
data/bis_ids_dollar/_FAILED/
